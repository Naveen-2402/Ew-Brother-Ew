<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header: tap opens the app -->
    <LinearLayout
        android:id="@+id/w_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_reels"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="0"
            android:textColor="@color/pista"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="5dp"
            android:layout_weight="1"
            android:text="reels today"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/w_tasks_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 tasks left"
                android:textColor="@color/chalk"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/w_habits_done"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 of 0 habits"
                android:textColor="@color/chalk"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/w_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Nothing left. Go touch grass."
        android:textColor="@color/muted"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/w_task1"
        style="@style/WidgetTaskRow" />

    <TextView
        android:id="@+id/w_task2"
        style="@style/WidgetTaskRow" />

    <TextView
        android:id="@+id/w_task3"
        style="@style/WidgetTaskRow" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_habit1"
            style="@style/WidgetHabitChip" />

        <TextView
            android:id="@+id/w_habit2"
            style="@style/WidgetHabitChip" />

        <TextView
            android:id="@+id/w_habit3"
            style="@style/WidgetHabitChip" />

        <TextView
            android:id="@+id/w_habit4"
            style="@style/WidgetHabitChip" />
    </LinearLayout>
</LinearLayout>
