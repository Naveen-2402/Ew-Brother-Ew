<?xml version="1.0" encoding="utf-8"?>
<!-- Not scoped with packageNames: we must see when you LEAVE Instagram/YouTube
     (to hide the bubble) and when you open focus-blocked apps. Events from other
     apps are dropped in the first line of onAccessibilityEvent (cheap string compare).
     notificationTimeout=100 coalesces scroll bursts to save battery.
     flagRetrieveInteractiveWindows: lets the service read the window list, so a pop-up from
     another package inside YouTube/Instagram isn't mistaken for leaving the app. -->

<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeViewScrolled|typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="100"
    android:description="@string/a11y_description" />
